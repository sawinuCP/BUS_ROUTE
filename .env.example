# Sri Lanka Journey Planner — environment template (Phase 0.3)
# Copy to `.env` and adjust for your machine. NEVER commit real `.env` files.
# Values here are local-development placeholders only.

# ---- Application ----
APP_ENV=local                 # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# ---- PostgreSQL + PostGIS (compose service `db`) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=journey_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only

# SQLAlchemy async driver URL (used by the app and Alembic).
# Inside Docker Compose the backend uses the service name `db` (override applied in compose file).
DATABASE_URL=postgresql+asyncpg://postgres:change-me-local-only@localhost:5432/journey_planner

# ---- Redis (compose service `redis`) ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
# JSON array of allowed origins; mobile dev servers typically use 8081.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
