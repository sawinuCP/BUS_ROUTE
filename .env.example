# Sri Lanka Journey Planner â€” environment template
# Copy to `.env` and adjust for your machine. NEVER commit real `.env` files.
# Values here are local-development placeholders only.

# ---- Application ----
APP_ENV=local                 # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# ---- PostgreSQL + PostGIS (compose service `db`) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=journey_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only

# SQLAlchemy async driver URL (used by the app and Alembic).
# Inside Docker Compose the backend uses the service name `db` (override applied in compose file).
DATABASE_URL=postgresql+asyncpg://postgres:change-me-local-only@localhost:5433/journey_planner

# ---- Redis (compose service `redis`) ----
REDIS_URL=redis://localhost:6379/0

# ---- Raw-source archive (immutable snapshots) ----
RAW_ARCHIVE_DIR=data/raw

# ---- Data-quality reports ----
VALIDATION_REPORTS_DIR=data/validation_reports

# ---- Pilot coverage (Overpass bbox: south,west,north,east) ----
# D-8 (2026-11-20): Western Province, approved by the owner.
PILOT_BBOX=6.60,79.75,7.30,80.25

# ---- OSM Overpass API ----
OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Community mirror used when the primary returns transient errors:
OSM_OVERPASS_FALLBACK=https://overpass.kumi.systems/api/interpreter
# Overpass query execution timeout â€” larger bboxes need longer:
OSM_OVERPASS_TIMEOUT_SECONDS=300

# ---- CORS ----
# JSON array of allowed origins; mobile dev servers typically use 8081.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# ---- Mobile (inlined into the app bundle as EXPO_PUBLIC_*; non-secret only) ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# MapLibre vector style. Default demo style is development-only; a production
# basemap provider is a separate owner decision (licensing + hosting).
EXPO_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
