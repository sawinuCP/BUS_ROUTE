# Mobile environment template — copy to `.env` (gitignored).
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle.
# NEVER put secrets here; they would ship inside the app binary.

# Base URL of the backend API (no trailing slash).
# On Android emulators use http://10.0.2.2:8000 to reach the host machine.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
